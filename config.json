{
  "project": {
    "name": "护理科研文献日报",
    "timezone": "Asia/Shanghai"
  },

  "window": {
    "days": 3,
    "max_catchup_days": 30,
    "max_items_per_journal": 60,
    "workers": 6,
    "rss_timeout_seconds": 25,
    "api_timeout_seconds": 45,
    "retries": 2,
    "sources": {
      "rss": true,
      "openalex": true,
      "crossref": true
    }
  },

  "output": {
    "dir": "reports",
    "keep_days": 365,
    "max_entries": 20,
    "open_after_run": false,
    "write_json_snapshot": true,
    "source_status": "summary",
    "frontmatter": true,
    "cards": true,
    "cards_html": "docs/index.html"
  },

  "keywords": [
    {
      "label": "脑卒中护理",
      "main": true,
      "weight": 3,
      "terms": [
        "stroke nursing",
        "stroke care",
        "post-stroke care",
        "nursing care of stroke",
        "stroke rehabilitation nursing"
      ]
    },
    {
      "label": "心血管护理",
      "main": true,
      "weight": 3,
      "terms": [
        "cardiovascular nursing",
        "cardiac nursing",
        "cardiovascular care",
        "cardiac care",
        "cardiovascular disease nursing"
      ]
    },
    {
      "label": "移植教育",
      "main": true,
      "weight": 3,
      "terms": [
        "transplant education",
        "transplantation education",
        "transplant patient education",
        "pre-transplant education",
        "post-transplant education",
        "transplant self-management education"
      ]
    },
    {
      "label": "移植",
      "main": true,
      "weight": 3,
      "terms": [
        "transplantation",
        "organ transplantation",
        "solid organ transplantation",
        "stem cell transplantation",
        "hematopoietic stem cell transplantation",
        "bone marrow transplantation"
      ]
    },
    {
      "label": "老年人",
      "main": true,
      "weight": 3,
      "terms": [
        "older adults",
        "older people",
        "older patients",
        "elderly",
        "geriatric patients"
      ]
    },
    {
      "label": "痴呆",
      "main": true,
      "weight": 3,
      "terms": [
        "dementia",
        "Alzheimer disease",
        "Alzheimer's disease",
        "major neurocognitive disorder",
        "dementia care"
      ]
    },
    {
      "label": "护理教育",
      "main": true,
      "weight": 3,
      "terms": [
        "nursing education",
        "nurse education",
        "nursing students",
        "undergraduate nursing education",
        "clinical nursing education",
        "nursing teaching"
      ]
    }
  ],

  "exclude_terms": [
    "retraction",
    "retracted",
    "correction",
    "corrigendum",
    "erratum",
    "author correction",
    "publisher correction",
    "editorial board",
    "in this issue",
    "issue information",
    "table of contents",
    "call for papers"
  ],

  "exclude_doi_prefixes": [],

  "tiers": {
    "must_read": 12,
    "worth_reading": 6,
    "min_score": 3
  },

  "journals": [
    {
      "name": "International Journal of Nursing Studies",
      "issn": "0020-7489",
      "rss": "",
      "enabled": true
    },
    {
      "name": "Journal of Nursing Regulation",
      "issn": "2155-8256",
      "rss": "",
      "enabled": true
    },
    {
      "name": "European Journal of Cardiovascular Nursing",
      "issn": "1474-5151",
      "rss": "",
      "enabled": true
    },
    {
      "name": "Worldviews on Evidence-Based Nursing",
      "issn": "1545-102X",
      "rss": "",
      "enabled": true
    },
    {
      "name": "BMC Nursing",
      "issn": "1472-6955",
      "rss": "",
      "enabled": true
    },
    {
      "name": "Hepatobiliary Surgery and Nutrition",
      "issn": "2304-3881",
      "rss": "",
      "enabled": true
    },
    {
      "name": "Stroke",
      "issn": "0039-2499",
      "rss": "",
      "enabled": true
    },
    {
      "name": "Food Science and Human Wellness",
      "issn": "2213-4530",
      "rss": "",
      "enabled": true
    }
  ],

  "push": {
    "enabled": false,
    "skip_when_empty": true,
    "max_items": 10,
    "max_chars": 5000,
    "channels": {
      "serverchan": {
        "enabled": false,
        "sendkey": ""
      },
      "pushplus": {
        "enabled": false,
        "token": ""
      },
      "bark": {
        "enabled": false,
        "key": "",
        "server": "https://api.day.app",
        "sound": "bird"
      }
    }
  },

  "ai_summary": {
    "enabled": true,
    "model": "gpt-6-luna",
    "max_items": 20
  },

  "email": {
    "enabled": true,
    "skip_when_empty": true,
    "max_items": 20,
    "subject_prefix": "护理科研文献日报",
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 465,
    "use_ssl": true
  },

  "log": {
    "dir": "logs",
    "level": "INFO"
  }
}
